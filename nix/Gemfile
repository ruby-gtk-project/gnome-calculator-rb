# frozen_string_literal: true

# The app's RUNTIME gems, for bundlerEnv in flake.nix. Generated by
# converge-port-gem.sh from the gemspec; do not edit by hand.
#
# The Gemfile at the repo root is kettle-jem's development bundle —
# rubocop, rspec, yard and the kettle-dev stack — and must not end up in
# a packaged app's closure.
source "https://rubygems.org"

gem "adwaita"
gem "gtk4"
gem "glib2"

# bigdecimal stopped being a default gem in Ruby 3.4; Number needs it.
gem "bigdecimal"

# rexml stopped being a default gem in Ruby 3.0; the ECB and Bank of Canada
# rate files are XML.
gem "rexml"

# Downloads the ECB and Bank of Canada exchange-rate files over HTTP, via
# libsoup 3 (see flake.nix's gtkStack for the typelib).
gem "soup3"
